# Application
APP_NAME="EVA"
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost
ADMIN_API_TOKEN=

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eva
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Branding
BRAND_NAME=EVA
BRAND_TAGLINE="Evidency Algorithm"
BRAND_PRIMARY_COLOR=#151515
BRAND_SECONDARY_COLOR=#090909
BRAND_ACCENT_COLOR=#dfff00
BRAND_LOGO_URL=

# Documents and queue
DOCUMENT_MAX_BYTES=10485760
QUEUE_MAX_FAILURES=3
QUEUE_WORKER_ID=local-worker

# AI safeguards and shared limits
AI_LIVE_ENABLED=false
AI_REQUEST_TIMEOUT=30
AI_MAX_NEW_SUMMARIES_PER_RUN=5
AI_MAX_OUTPUT_TOKENS=1500
AI_QUERY_MAX_OUTPUT_TOKENS=1800

# Query and Context Intelligence Engine
QUERY_CANDIDATE_LIMIT=20
QUERY_MAX_EVIDENCE=10
QUERY_MAX_INTERACTIONS=20

# Embeddings capability
AI_EMBEDDING_PROVIDER=
AI_EMBEDDING_ENDPOINT=
AI_EMBEDDING_MODEL=
AI_EMBEDDING_API_KEY_ENV=EVA_AI_API_KEY
AI_EMBEDDING_BATCH_UNITS=64
AI_EMBEDDING_MAX_INPUT_TOKENS=8192

# Summary capability
AI_SUMMARY_PROVIDER=
AI_SUMMARY_ENDPOINT=
AI_SUMMARY_MODEL=
AI_SUMMARY_API_KEY_ENV=EVA_AI_API_KEY

# Query-answer capability
AI_QUERY_PROVIDER=
AI_QUERY_ENDPOINT=
AI_QUERY_MODEL=
AI_QUERY_API_KEY_ENV=EVA_AI_API_KEY

# Optional shared language-capability fallback
AI_LANGUAGE_PROVIDER=
AI_LANGUAGE_ENDPOINT=
AI_LANGUAGE_API_KEY_ENV=EVA_AI_API_KEY

# Neutral credential placeholder; keep empty in the public template
EVA_AI_API_KEY=

# Catálogo obrigatório de configuração - Idioma: Português
# APP_NAME: nome técnico da aplicação disponível no container interno.
# APP_ENV: identifica o ambiente operacional, por exemplo production ou local.
# APP_DEBUG: habilita ou desabilita o modo de depuração da aplicação.
# APP_URL: URL-base esperada para a instalação atual.
# ADMIN_API_TOKEN: credencial do superadmin, com no mínimo 24 caracteres.
# BRAND_NAME: nome público apresentado pela interface e pela API de branding.
# BRAND_TAGLINE: descrição curta apresentada ao lado do nome da marca.
# BRAND_PRIMARY_COLOR: cor primária hexadecimal da identidade visual.
# BRAND_SECONDARY_COLOR: cor secundária hexadecimal da identidade visual.
# BRAND_ACCENT_COLOR: cor hexadecimal de destaque da identidade visual.
# BRAND_LOGO_URL: caminho iniciado por / ou URL HTTPS do logotipo público.
# DB_HOST: endereço do servidor MySQL ou MariaDB.
# DB_PORT: porta de conexão do banco de dados.
# DB_DATABASE: nome do banco de dados da aplicação.
# DB_USERNAME: usuário utilizado na conexão com o banco.
# DB_PASSWORD: senha utilizada na conexão com o banco; pode ser vazia localmente.
# DB_CHARSET: charset da conexão com o banco de dados.
# DOCUMENT_MAX_BYTES: tamanho máximo aceito para upload de um documento.
# QUEUE_MAX_FAILURES: máximo de falhas permitidas antes do bloqueio de um trabalho.
# QUEUE_WORKER_ID: identificador operacional gravado ao bloquear trabalhos da fila.
# AI_LIVE_ENABLED: autorização operacional para chamadas reais de IA.
# AI_REQUEST_TIMEOUT: timeout, em segundos, das requisições aos provedores.
# AI_MAX_NEW_SUMMARIES_PER_RUN: máximo de novos resumos criados por execução.
# AI_MAX_OUTPUT_TOKENS: teto de tokens de saída utilizado na geração de resumos.
# AI_QUERY_MAX_OUTPUT_TOKENS: teto de tokens por tentativa de resposta documental.
# QUERY_CANDIDATE_LIMIT: Top-k vetorial analisado pelo CIE antes do contexto final.
# QUERY_MAX_EVIDENCE: limite global de evidências primárias entregues à IA após o CIE.
# QUERY_MAX_INTERACTIONS: limite de interações relacionais transitórias na resposta.
# AI_EMBEDDING_PROVIDER: identificador gerencial do fornecedor de embeddings.
# AI_EMBEDDING_ENDPOINT: endpoint HTTPS utilizado para gerar embeddings.
# AI_EMBEDDING_MODEL: modelo utilizado para gerar embeddings.
# AI_EMBEDDING_API_KEY_ENV: nome da variável de ambiente que contém a credencial de embeddings.
# EMBEDDING_API_KEY: exemplo opcional de variável local quando indicada por AI_EMBEDDING_API_KEY_ENV.
# AI_EMBEDDING_BATCH_UNITS: máximo de unidades completas por lote de embeddings.
# AI_EMBEDDING_MAX_INPUT_TOKENS: limite do provedor por unidade; a aplicação reserva margem preventiva de 10%.
# AI_SUMMARY_PROVIDER: fornecedor exclusivo de resumos; vazio herda AI_LANGUAGE_PROVIDER.
# AI_SUMMARY_ENDPOINT: endpoint exclusivo de resumos; vazio herda AI_LANGUAGE_ENDPOINT.
# AI_SUMMARY_MODEL: modelo utilizado para gerar resumos hierárquicos.
# AI_SUMMARY_API_KEY_ENV: nome da credencial exclusiva de resumos; vazio herda AI_LANGUAGE_API_KEY_ENV.
# AI_QUERY_PROVIDER: fornecedor exclusivo de consultas; vazio herda AI_LANGUAGE_PROVIDER.
# AI_QUERY_ENDPOINT: endpoint exclusivo de consultas; vazio herda AI_LANGUAGE_ENDPOINT.
# AI_QUERY_MODEL: modelo utilizado para responder às consultas documentais.
# AI_QUERY_API_KEY_ENV: nome da credencial exclusiva de consultas; vazio herda AI_LANGUAGE_API_KEY_ENV.
# AI_LANGUAGE_PROVIDER: fornecedor geral herdado por resumos e consultas.
# AI_LANGUAGE_ENDPOINT: endpoint geral herdado por resumos e consultas.
# AI_LANGUAGE_API_KEY_ENV: nome da variável de credencial geral herdada por resumos e consultas.
# INTERACT_API_KEY: exemplo legado opcional; somente é lido se seu nome for indicado explicitamente em uma configuração de credencial.
# EVA_AI_API_KEY: placeholder neutro compartilhado do template público; deve permanecer vazio até a configuração local.

# Mandatory Configuration Catalog - Language: English
# APP_NAME: technical application name available in the internal container.
# APP_ENV: identifies the operating environment, such as production or local.
# APP_DEBUG: enables or disables application debug mode.
# APP_URL: expected base URL for the current installation.
# ADMIN_API_TOKEN: superadmin credential with a minimum length of 24 characters.
# BRAND_NAME: public name presented by the interface and branding API.
# BRAND_TAGLINE: short description displayed with the brand name.
# BRAND_PRIMARY_COLOR: hexadecimal primary color for the visual identity.
# BRAND_SECONDARY_COLOR: hexadecimal secondary color for the visual identity.
# BRAND_ACCENT_COLOR: hexadecimal accent color for the visual identity.
# BRAND_LOGO_URL: public logo path beginning with / or an HTTPS URL.
# DB_HOST: MySQL or MariaDB server address.
# DB_PORT: database connection port.
# DB_DATABASE: application database name.
# DB_USERNAME: username used for the database connection.
# DB_PASSWORD: password used for the database connection; it may be empty locally.
# DB_CHARSET: character set used by the database connection.
# DOCUMENT_MAX_BYTES: maximum accepted document-upload size in bytes.
# QUEUE_MAX_FAILURES: maximum allowed failures before a job is blocked.
# QUEUE_WORKER_ID: operational identifier recorded when queue jobs are locked.
# AI_LIVE_ENABLED: operational authorization for real AI provider calls.
# AI_REQUEST_TIMEOUT: provider request timeout in seconds.
# AI_MAX_NEW_SUMMARIES_PER_RUN: maximum number of new summaries created per run.
# AI_MAX_OUTPUT_TOKENS: output-token ceiling used for summary generation.
# AI_QUERY_MAX_OUTPUT_TOKENS: output-token ceiling for each documentary-answer attempt.
# QUERY_CANDIDATE_LIMIT: vector Top-k analyzed by CIE before final context selection.
# QUERY_MAX_EVIDENCE: global limit of primary evidence delivered to AI after CIE.
# QUERY_MAX_INTERACTIONS: limit of transient relational interactions in a response.
# AI_EMBEDDING_PROVIDER: management identifier of the embedding provider.
# AI_EMBEDDING_ENDPOINT: HTTPS endpoint used to generate embeddings.
# AI_EMBEDDING_MODEL: model used to generate embeddings.
# AI_EMBEDDING_API_KEY_ENV: name of the environment variable containing the embedding credential.
# EMBEDDING_API_KEY: optional example of a local variable selected by AI_EMBEDDING_API_KEY_ENV.
# AI_EMBEDDING_BATCH_UNITS: maximum number of complete units in one embedding batch.
# AI_EMBEDDING_MAX_INPUT_TOKENS: provider limit per unit; the application reserves a preventive 10% margin.
# AI_SUMMARY_PROVIDER: summary-specific provider; when empty, inherits AI_LANGUAGE_PROVIDER.
# AI_SUMMARY_ENDPOINT: summary-specific endpoint; when empty, inherits AI_LANGUAGE_ENDPOINT.
# AI_SUMMARY_MODEL: model used to generate hierarchical summaries.
# AI_SUMMARY_API_KEY_ENV: name of the summary-specific credential; when empty, inherits AI_LANGUAGE_API_KEY_ENV.
# AI_QUERY_PROVIDER: query-specific provider; when empty, inherits AI_LANGUAGE_PROVIDER.
# AI_QUERY_ENDPOINT: query-specific endpoint; when empty, inherits AI_LANGUAGE_ENDPOINT.
# AI_QUERY_MODEL: model used to answer documentary queries.
# AI_QUERY_API_KEY_ENV: name of the query-specific credential; when empty, inherits AI_LANGUAGE_API_KEY_ENV.
# AI_LANGUAGE_PROVIDER: shared provider inherited by summaries and queries.
# AI_LANGUAGE_ENDPOINT: shared endpoint inherited by summaries and queries.
# AI_LANGUAGE_API_KEY_ENV: name of the shared credential variable inherited by summaries and queries.
# INTERACT_API_KEY: optional legacy example; read only if explicitly selected by a credential configuration.
# EVA_AI_API_KEY: neutral shared credential placeholder in the public template; keep it empty until local configuration.
